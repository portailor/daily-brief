    개인 맞춤 자문이 아닙니다. 투자자문업으로 등록된 곳에서 만든 것이 아닙니다.
    확률은 과거 빈도일 뿐 미래를 보장하지 않습니다. 이 내용을 참고한 투자 판단과
    그 결과에 대한 책임은 전적으로 본인에게 있으며, 제작자는 어떠한 손실에도
    책임을 지지 않습니다.
  </div>
</footer>

</div>

<script>
/* 용어 말풍선.
   말풍선이 position:fixed 이므로 좌표를 직접 잡아준다. 이렇게 해야
   가로 스크롤되는 표 안에서도 잘리지 않고, sticky 셀에 가려지지도 않는다.

   클릭으로 열고 닫는다 — 터치 기기에는 hover 가 없고,
   마우스에서도 표를 훑다 보면 말풍선이 계속 튀어나와 성가시기 때문이다. */
(function () {
  var open = null;
  var openTip = null;
  var MARGIN = 8;

  function close() {
    if (!open) return;
    open.classList.remove('open');
    if (openTip) { openTip.style.display = ''; open.appendChild(openTip); }
    open = null;
    openTip = null;
  }

  function place(term) {
    var tip = openTip;
    if (!tip) return;

    tip.style.left = '0px';
    tip.style.top = '0px';

    var r = term.getBoundingClientRect();
    var t = tip.getBoundingClientRect();
    var vw = document.documentElement.clientWidth;
    var vh = document.documentElement.clientHeight;

    // 가로: 단어 왼쪽에 맞추되 화면 밖으로 나가지 않게 민다
    var left = Math.min(Math.max(MARGIN, r.left), vw - t.width - MARGIN);

    // 세로: 아래가 좁으면 단어 위로 띄운다
    var below = vh - r.bottom;
    var top = (below < t.height + 16 && r.top > t.height + 16)
      ? r.top - t.height - 7
      : r.bottom + 7;
    top = Math.min(Math.max(MARGIN, top), vh - t.height - MARGIN);

    tip.style.left = left + 'px';
    tip.style.top = top + 'px';
  }

  document.addEventListener('click', function (e) {
    if (e.target.closest('.tip')) return;          // 말풍선 안 클릭은 무시

    var term = e.target.closest('.term');
    if (!term) { close(); return; }

    e.preventDefault();
    if (term === open) { close(); return; }
    close();

    var tip = term.querySelector('.tip');
    if (!tip) return;

    /* 말풍선을 body 로 옮긴다.
       표 첫 열은 position:sticky 에 배경색이 있어서, 그 자리에 둔 채로는
       z-index 를 아무리 올려도 옆 칸 배경에 왼쪽이 잘려 보인다.
       body 직속이면 어떤 쌓임 맥락에도 갇히지 않는다. */
    term.classList.add('open');
    open = term;
    openTip = tip;
    document.body.appendChild(tip);
    tip.style.display = 'block';
    place(term);
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') close();
  });

  // 스크롤하거나 창 크기가 바뀌면 좌표가 어긋나므로 따라가게 한다
  ['scroll', 'resize'].forEach(function (ev) {
    window.addEventListener(ev, function () { if (open) place(open); }, true);
  });
})();
</script>
</body>
</html>
