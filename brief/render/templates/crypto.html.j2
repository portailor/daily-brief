{# 코인 탭. 24시간 거래라 '마감'이 없다 — 수집 시각을 붙이고, 변동률은 모두 24시간 전 대비. #}
{% set cx = crypto or {} %}

<section>
  <h2>주요 코인 · 24시간</h2>
  {% if cx.majors %}
  <p class="hint-plain"><b>{{ cx.asof }} 기준</b>(한국시간) · 24시간 전 대비. 브리핑을 여는 시점엔 이미 바뀌었을 수 있습니다.</p>
  <div class="card">
    <div class="cx-row cx-head"><span>코인</span><span>달러 가격</span><span>24시간</span><span>7일</span></div>
    {% for c in cx.majors %}
    <div class="cx-row">
      <span class="re-name">{{ c.name }}</span>
      <span class="num">${{ '{:,.2f}'.format(c.usd) if c.usd < 1000 else '{:,.0f}'.format(c.usd) }}</span>
      <span class="num {{ 'up' if c.chg24 > 0 else 'down' if c.chg24 < 0 else '' }}">{{ '%+.1f'|format(c.chg24) }}%</span>
      <span class="num {{ 'up' if c.chg7d and c.chg7d > 0 else 'down' if c.chg7d and c.chg7d < 0 else '' }}">{{ ('%+.1f'|format(c.chg7d) ~ '%') if c.chg7d is not none else '—' }}</span>
    </div>
    {% endfor %}
  </div>

  <div class="card" style="margin-top:8px">
    <div class="re-sub">업비트 원화 가격 · {{ cx_terms.premium|safe }}</div>
    {% for c in cx.majors %}
    <div class="re-pair">
      <span>{{ c.name }} <span class="num" style="color:var(--dim)">{{ '{:,.0f}'.format(c.krw) if c.krw else '—' }}원</span></span>
      <span class="num {{ 'up' if c.premium and c.premium > 0 else 'down' if c.premium and c.premium < 0 else '' }}">{{ ('%+.2f'|format(c.premium) ~ '%') if c.premium is not none else '—' }}</span>
    </div>
    {% endfor %}
    {% if cx.fx %}<div class="re-src" style="margin-top:6px">해외 시세를 원/달러 {{ '{:,.1f}'.format(cx.fx) }}원으로 환산해 비교 (CoinGecko 환산)</div>{% endif %}
  </div>
  {% else %}
  <div class="card"><div class="pocket nodata">코인 시세를 가져오지 못했습니다.</div></div>
  {% endif %}
</section>

{# ── 30일 흐름: 코인마다 선 하나(범례 없음 — 제목이 곧 이름). 최고·최저만 값을 적고,
   나머지 날짜는 손가락/마우스를 올리면 나온다. 표로도 볼 수 있게 접어 둔다. ── #}
{% macro usd(v) %}${{ '{:,.0f}'.format(v) if v >= 1000 else '{:,.2f}'.format(v) }}{% endmacro %}
{% macro spark(h) %}
{% set VW, VH, PL, PR, PT, PB = 340, 150, 10, 10, 24, 24 %}
{% set vals = h.points | map(attribute='p') | list %}
{% set hi, lo = vals | max, vals | min %}
{% set span = (hi - lo) if hi > lo else 1 %}
{% set n = vals | length %}
{% set step = (VW - PL - PR) / (n - 1) %}
{% set ns = namespace(d='', hi_i=0, lo_i=0) %}
{% for v in vals %}
  {% set x = PL + loop.index0 * step %}{% set y = PT + (hi - v) / span * (VH - PT - PB) %}
  {% set ns.d = ns.d ~ ('M' if loop.first else ' L') ~ ('%.1f'|format(x)) ~ ',' ~ ('%.1f'|format(y)) %}
  {% if v == hi %}{% set ns.hi_i = loop.index0 %}{% endif %}
  {% if v == lo %}{% set ns.lo_i = loop.index0 %}{% endif %}
{% endfor %}
{% set hx = PL + ns.hi_i * step %}{% set lx = PL + ns.lo_i * step %}
{% set ly = VH - PB %}
<div class="cx-chart" data-pts='{{ vals | map("round", 2) | list | tojson }}'
     data-days='{{ h.points | map(attribute="d") | list | tojson }}'
     data-pl="{{ PL }}" data-pr="{{ PR }}" data-pt="{{ PT }}" data-pb="{{ PB }}"
     data-hi="{{ hi }}" data-lo="{{ lo }}" tabindex="0" role="img"
     aria-label="{{ h.name }} 지난 30일 달러 가격. 최고 {{ usd(hi) }}({{ h.points[ns.hi_i].d }}), 최저 {{ usd(lo) }}({{ h.points[ns.lo_i].d }})">
  <svg viewBox="0 0 {{ VW }} {{ VH }}" preserveAspectRatio="none" aria-hidden="true">
    <line x1="{{ PL }}" x2="{{ VW - PR }}" y1="{{ ly }}" y2="{{ ly }}" class="cx-axis" vector-effect="non-scaling-stroke"/>
    <path d="{{ ns.d }}" class="cx-line" vector-effect="non-scaling-stroke"/>
    <line class="cx-cross" x1="0" x2="0" y1="{{ PT - 6 }}" y2="{{ ly }}" vector-effect="non-scaling-stroke"/>
  </svg>
  {# 값 글자와 점은 SVG 밖 HTML 로 — 가로로 늘어나는 그림에서 글자가 찌그러지지 않게 #}
  <span class="cx-dot" style="left:{{ '%.2f'|format(hx / VW * 100) }}%;top:{{ PT }}px"></span>
  <span class="cx-lbl {{ 'r' if hx > VW * 0.7 else 'l' if hx < VW * 0.3 else '' }}" style="left:{{ '%.2f'|format(hx / VW * 100) }}%;top:{{ PT - 20 }}px">최고 {{ usd(hi) }}</span>
  <span class="cx-dot" style="left:{{ '%.2f'|format(lx / VW * 100) }}%;top:{{ VH - PB }}px"></span>
  <span class="cx-lbl {{ 'r' if lx > VW * 0.7 else 'l' if lx < VW * 0.3 else '' }}" style="left:{{ '%.2f'|format(lx / VW * 100) }}%;top:{{ VH - PB + 4 }}px">최저 {{ usd(lo) }}</span>
  <span class="cx-hover-dot"></span>
  <div class="cx-tip" role="status"></div>
  <div class="cx-xaxis"><span>{{ h.points[0].d }}</span><span>지금</span></div>
</div>
{% endmacro %}

{% if cx.history %}
<section>
  <h2>지난 30일 흐름</h2>
  <p class="hint-plain">달러 가격 · 하루 한 점(한국시간 오전 9시 값) · 마지막 점만 {{ cx.asof }} 가격 · 그래프를 누르거나 마우스를 올리면 날짜별 값</p>
  <div class="cx-charts">
    {% for h in cx.history %}
    <div class="card">
      <div class="re-item-top">
        <span class="re-name">{{ h.name }}</span>
        <span><span class="num">{{ usd(h.points[-1].p) }}</span>
          <span class="num {{ 'up' if h.chg > 0 else 'down' if h.chg < 0 else '' }}" style="margin-left:4px">{{ '%+.1f'|format(h.chg) }}%</span></span>
      </div>
      <div class="re-src">{{ h.points[0].d }} 오전 9시 대비</div>
      {{ spark(h) }}
      <details class="cx-table"><summary>날짜별 값 보기</summary>
        <div class="cx-tgrid">{% for p in h.points | reverse %}<span>{{ p.d }}</span><span class="num">{{ usd(p.p) }}</span>{% endfor %}</div>
      </details>
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}

{% if cx.market or cx.fng or cx.stable %}
<section>
  <h2>코인 시장 전체</h2>
  <div class="card">
    {% if cx.market %}
    <div class="re-item">
      <div class="re-item-top"><span class="re-name">전체 시가총액</span><span class="asof">{{ cx.asof }}</span></div>
      <div class="re-item-val">
        <span class="num re-big">${{ '%.2f'|format(cx.market.cap_usd / 1e12) }}조</span>
        <span class="num {{ 'up' if cx.market.cap_chg24 > 0 else 'down' }}">{{ '%+.1f'|format(cx.market.cap_chg24) }}%</span>
        <span class="re-note">24시간 전 대비</span>
      </div>
    </div>
    <div class="re-item">
      <div class="re-item-top"><span class="re-name">{{ cx_terms.dominance|safe }}</span><span class="asof">{{ cx.asof }}</span></div>
      <div class="re-item-val">
        <span class="num re-big">{{ '%.1f'|format(cx.market.btc_dom) }}%</span>
        <span class="re-note">이더리움 {{ '%.1f'|format(cx.market.eth_dom) }}%</span>
      </div>
    </div>
    {% endif %}
    {% if cx.stable %}
    <div class="re-item">
      <div class="re-item-top"><span class="re-name">달러 스테이블코인 총 발행액</span><span class="asof">{{ cx.stable.asof }}</span></div>
      <div class="re-item-val">
        <span class="num re-big">{{ '{:,.0f}'.format(cx.stable.usd / 1e8) }}억 달러</span>
        <span class="num {{ 'up' if cx.stable.d7 > 0 else 'down' }}">7일 {{ '%+.1f'|format(cx.stable.d7 / 1e8) }}억 달러</span>
        <span class="num {{ 'up' if cx.stable.d30 > 0 else 'down' }}">30일 {{ '%+.1f'|format(cx.stable.d30 / 1e8) }}억 달러</span>
      </div>
      <div class="re-src">DefiLlama · 코인을 사기 위해 대기 중인 달러의 크기로 봅니다. 늘면 시장에 들어온 돈이 늘었다는 뜻</div>
    </div>
    {% endif %}
    {% if cx.fng %}
    <div class="re-item">
      <div class="re-item-top"><span class="re-name">{{ cx_terms.fng|safe }}</span><span class="asof">{{ cx.fng.asof }}</span></div>
      <div class="re-item-val">
        <span class="num re-big">{{ cx.fng.value }}</span>
        <span class="re-note" style="font-size:13px;color:var(--ink)">{{ cx.fng.label }}</span>
        {% if cx.fng.prev is not none %}<span class="re-note">전날 {{ cx.fng.prev }}</span>{% endif %}
      </div>
      <div class="re-src">alternative.me · 0 극단적 공포 ~ 100 극단적 탐욕</div>
    </div>
    {% endif %}
  </div>
</section>
{% endif %}

{% set fl = cx.flows or {} %}
{% macro usd_eok(v, sign=True) %}{{ ('{:+,.1f}' if sign else '{:,.1f}').format(v / 1e8) if (v|abs) < 1e11 else ('{:+,.0f}' if sign else '{:,.0f}').format(v / 1e8) }}억 달러{% endmacro %}
{% if fl.etf or fl.treasury %}
<section>
  <h2>큰돈의 움직임</h2>
  {% if fl.etf %}
  <p class="hint-plain">미국 현물 ETF 전체에 하루 동안 들어오고 나간 돈 · 미국 거래일 기준(보통 다음 날 아침 집계) · SoSoValue</p>
  <div class="cx-charts">
    {% for e in fl.etf %}
    <div class="card">
      <div class="re-item-top">
        <span class="re-name">{{ e.name }} ETF</span>
        <span class="asof">미국 {{ e.date[5:7]|int }}/{{ e.date[8:10]|int }}</span>
      </div>
      <div class="re-item-val">
        <span class="num re-big {{ 'up' if e.flow > 0 else 'down' if e.flow < 0 else '' }}">{{ usd_eok(e.flow) }}</span>
        <span class="re-note">{{ '순유입' if e.flow > 0 else '순유출' }}{% if e.streak|abs >= 2 %} · {{ e.streak|abs }}거래일 연속{% endif %}</span>
      </div>
      {% set mx = e.days | map(attribute='flow') | map('abs') | max %}
      <div class="etf-bars" role="img" aria-label="{{ e.name }} ETF 최근 {{ e.days|length }}거래일 순유입">
        {% for d in e.days %}
        <span class="etf-col" title="{{ d.date[5:7]|int }}/{{ d.date[8:10]|int }} {{ usd_eok(d.flow) }}">
          <i class="{{ 'pos' if d.flow >= 0 else 'neg' }}" style="height:{{ ((d.flow|abs) / (mx or 1) * 50)|round(1) }}%"></i>
        </span>
        {% endfor %}
      </div>
      <div class="cx-xaxis" style="position:static;margin-top:2px"><span>{{ e.days[0].date[5:7]|int }}/{{ e.days[0].date[8:10]|int }}</span><span>{{ e.days[-1].date[5:7]|int }}/{{ e.days[-1].date[8:10]|int }}</span></div>
      <div class="re-src">최근 5거래일 {{ usd_eok(e.flow5) }} · 순자산 {{ usd_eok(e.assets, false) }}</div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if fl.treasury %}
  <div class="card" style="margin-top:8px">
    <div class="re-sub">비트코인을 사들인 상장사 · 최근 14일 (날짜는 회사 발표일)</div>
    {% for t in fl.treasury %}
    <div class="re-item">
      <div class="re-item-top">
        <span class="re-name">{{ t.name }} <span class="tk">{{ t.ticker }}</span></span>
        <span class="num {{ 'up' if t.btc > 0 else 'down' }}">{{ '{:+,.0f}'.format(t.btc) }} BTC</span>
      </div>
      <div class="re-note">{{ t.date[5:7]|int }}/{{ t.date[8:10]|int }}{% if t.cost %} · {{ '{:,.1f}'.format((t.cost|abs) / 1e6) }}백만 달러{% if t.price %}(개당 약 ${{ '{:,.0f}'.format(t.price) }}){% endif %}{% endif %}{% if t.holding %} · 보유 {{ '{:,.0f}'.format(t.holding) }} BTC{% endif %}</div>
    </div>
    {% endfor %}
    <div class="re-src">SoSoValue 비트코인 보유 기업 목록 중 보유량 상위 20곳</div>
  </div>
  {% endif %}
</section>
{% endif %}

{% if cx.top %}
<section>
  <h2>시가총액 상위 코인</h2>
  <p class="hint-plain">{{ cx_terms.stable|safe }}과 토큰화 자산은 뺐습니다 · 24시간 전 대비</p>
  <div class="card">
    {% for c in cx.top %}
    <div class="re-pair">
      <span><span class="num" style="color:var(--dim);display:inline-block;width:1.6em">{{ loop.index }}</span>{{ c.name }} <span class="tk">{{ c.sym }}</span></span>
      <span class="num {{ 'up' if c.chg24 and c.chg24 > 0 else 'down' if c.chg24 and c.chg24 < 0 else '' }}">{{ ('%+.1f'|format(c.chg24) ~ '%') if c.chg24 is not none else '—' }}</span>
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}

{% if cx.gainers %}
<section>
  <h2>24시간 급등 코인</h2>
  <p class="hint-plain">시가총액 상위 250개 중 24시간 상승률 순 · {{ cx_terms.stable|safe }}·토큰화 자산 제외</p>
  <div class="card">
    <div class="cx-row cx-head"><span>코인</span><span>시총 순위</span><span>24시간</span><span>7일</span></div>
    {% for c in cx.gainers %}
    <div class="cx-row">
      <span class="re-name">{% if cx.news %}<a class="nw-jump" href="#nw-{{ c.id }}">{{ c.name }}</a>{% else %}{{ c.name }}{% endif %} <span class="tk">{{ c.sym }}</span></span>
      <span class="num" style="color:var(--dim)">{{ c.rank or '—' }}위</span>
      <span class="num up">{{ '%+.1f'|format(c.chg24) }}%</span>
      <span class="num {{ 'up' if c.chg7d and c.chg7d > 0 else 'down' if c.chg7d and c.chg7d < 0 else '' }}">{{ ('%+.1f'|format(c.chg7d) ~ '%') if c.chg7d is not none else '—' }}</span>
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}

{% if cx.sectors %}
<section>
  <h2>분야별 흐름 · 24시간</h2>
  <p class="hint-plain">분야마다 속한 코인들의 시가총액 합이 24시간 전보다 얼마나 바뀌었는지 (CoinGecko 분류)</p>
  <div class="card">
    {% set mx = cx.sectors | map(attribute='chg24') | map('abs') | max %}
    {% for c in cx.sectors %}
    <div class="sec-row">
      <span class="sec-name">{{ c.name }}</span>
      <span class="sec-bar"><i class="{{ 'pos' if c.chg24 >= 0 else 'neg' }}" style="width:{{ ((c.chg24|abs) / (mx or 1) * 50)|round(1) }}%"></i></span>
      <span class="sec-pct num {{ 'up' if c.chg24 > 0 else 'down' if c.chg24 < 0 else '' }}">{{ '%+.1f'|format(c.chg24) }}%</span>
    </div>
    {% endfor %}
    <div class="re-src" style="margin-top:6px">시가총액: {% for c in cx.sectors %}{{ c.name }} {{ '{:,.0f}'.format(c.cap / 1e8) }}억 달러{{ ' · ' if not loop.last }}{% endfor %}</div>
  </div>
</section>
{% endif %}

{% if cx.trending %}
<section>
  <h2>검색 급상승 코인</h2>
  <p class="hint-plain">최근 24시간 CoinGecko 에서 사람들이 많이 찾아본 코인 순 · 관심이 몰렸다는 뜻이지 좋다는 뜻은 아닙니다</p>
  <div class="card">
    {% for c in cx.trending %}
    <div class="re-pair">
      <span><span class="num" style="color:var(--dim);display:inline-block;width:1.6em">{{ loop.index }}</span>{{ c.name }} <span class="tk">{{ c.sym }}</span>
        {% if c.rank %}<span class="re-note">시총 {{ c.rank }}위</span>{% endif %}</span>
      <span class="num {{ 'up' if c.chg24 and c.chg24 > 0 else 'down' if c.chg24 and c.chg24 < 0 else '' }}">{{ ('%+.1f'|format(c.chg24) ~ '%') if c.chg24 is not none else '—' }}</span>
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}

{% if fl.events %}
<section>
  <h2>앞으로 7일, 가격에 영향을 줄 수 있는 코인 일정</h2>
  <p class="hint-plain">시가총액 상위 100개 코인 · 날짜가 정해진 일정 중 종류를 알 수 있는 것만 · CoinMarketCal</p>
  <div class="card">
    {% for e in fl.events %}
    <div class="ev-row">
      <span class="ev-date">{{ e.label }}</span>
      <span class="ev-body">
        <span class="ev-coin"><span class="ev-coin-lb">코인</span>{% for c in e.coins %}<b>{{ c.sym }}</b>{% if c.name %}<span class="ev-coin-full">({{ c.name }})</span>{% endif %}{{ ', ' if not loop.last }}{% endfor %}</span>
        <span class="ev-kind">{{ e.kind }}</span>
        <span class="ev-title">{{ e.title }}</span>
        <span class="ev-about">{{ e.about }}</span>
        {% if e.tendency %}<span class="ev-tend"><b>과거 사례</b> {{ e.tendency }}{% if e.tsrc %} <a href="{{ e.tsrc[1] }}" target="_blank" rel="noopener">{{ e.tsrc[0] }}</a>{% endif %}</span>{% endif %}
        <a class="ev-more" href="{{ e.url or e.search }}" target="_blank" rel="noopener">{{ '원문 보기' if e.url else '관련 기사 찾기' }} ↗</a>
      </span>
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}

{% if cx.upbit_top %}
<section>
  <h2>업비트에서 많이 거래된 코인</h2>
  <p class="hint-plain">최근 24시간 원화 거래대금 순 · 국내 투자자의 돈이 실제로 몰린 곳</p>
  <div class="card">
    {% for c in cx.upbit_top %}
    <div class="re-pair">
      <span>{{ c.name }} <span class="tk">{{ c.sym }}</span></span>
      <span class="num">{{ '{:,.0f}'.format(c.value_eok) }}억원</span>
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}

{% if cx.missing %}
<div class="pocket nodata" style="margin-top:14px">가져오지 못한 항목: {{ cx.missing|join(', ') }}</div>
{% endif %}

<section>
  <details>
    <summary>숫자를 읽는 법</summary>
    <div class="deep">
      코인은 주말·밤에도 쉬지 않고 거래되어 '마감 가격'이 없습니다. 그래서 브리핑을 만든
      시각의 가격을 적고, 변동률은 모두 <b>그 시각 기준 24시간 전 대비</b>로 통일했습니다.<br><br>
      업비트 앱에 보이는 등락률은 매일 <b>오전 9시 가격 대비</b>라, 같은 순간에도 이 탭의
      숫자와 다를 수 있습니다. 둘 다 맞는 숫자이고 기준만 다릅니다.<br><br>
      달러 가격과 시가총액은 CoinGecko 집계이며, 만들 때 코인베이스·크라켄 거래소 체결가와
      0.04% 이내로 일치하는 것을 확인했습니다. 전망이나 추천은 넣지 않았습니다.
    </div>
  </details>
</section>

{# ── 눈여겨볼 코인: 급등·대표 코인마다 해외 기사 제목(영어 원문) 링크.
   '오른 이유'라고 쓰지 않는다 — 같은 시간대에 그 코인을 다룬 기사일 뿐이다. ── #}
{% set nw = cx.news or {} %}
{% if nw.watch %}
<section>
  <h2>눈여겨볼 코인 · 해외 뉴스</h2>
  <p class="hint-plain">24시간 급등 코인과 대표 코인 · 최근 48시간 해외 기사 중 <b>제목에 그 코인 이름이 나온 것</b> ·
    기사 제목은 영어 원문 그대로입니다. 기사가 가격을 움직였다는 뜻은 아닙니다.</p>
  <div class="card">
    {% for w in nw.watch %}
    <div class="re-item nw-item" id="nw-{{ w.id }}">
      <div class="re-item-top">
        <span class="re-name">{{ w.ko or w.name }} <span class="tk">{{ w.sym }}</span></span>
        <span>
          <span class="nw-why">{{ w.why }}</span>
          {% if w.chg24 is not none %}<span class="num {{ 'up' if w.chg24 > 0 else 'down' if w.chg24 < 0 else '' }}">{{ '%+.1f'|format(w.chg24) }}%</span>{% endif %}
        </span>
      </div>
      {% if w.news %}
      <ul class="nw-list">
        {% for n in w.news %}
        <li><a href="{{ n.url }}" target="_blank" rel="noopener">{{ n.title }}</a>
          <span class="nw-meta">{{ n.source }} · {{ n.when }}</span></li>
        {% endfor %}
      </ul>
      {% if w.news_n > w.news|length %}<div class="re-src">같은 48시간 안에 이 코인 이름이 나온 기사 {{ w.news_n }}건 중 최신 {{ w.news|length }}건</div>{% endif %}
      {% else %}
      <div class="re-note" style="margin-top:3px">최근 48시간 안에 제목에 이 코인 이름이 나온 해외 기사가 없습니다.</div>
      {% endif %}
    </div>
    {% endfor %}
  </div>

  {% if nw.institutional %}
  <div class="card" style="margin-top:8px">
    <div class="re-sub">기관·ETF 소식 · 제목에 ETF·기관·매수·보유·지분 같은 단어가 들어간 기사</div>
    <ul class="nw-list">
      {% for n in nw.institutional %}
      <li><a href="{{ n.url }}" target="_blank" rel="noopener">{{ n.title }}</a>
        <span class="nw-meta">{{ n.source }} · {{ n.when }}</span></li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}
  <div class="re-src" style="margin-top:6px">출처: {{ nw.sources|join(' · ') }} (RSS·Finnhub) · {{ cx.asof }} 기준 · 같은 소식을 여러 매체가 쓴 경우 하나만</div>
</section>
{% endif %}

{% if cx.history %}
<script>
/* 30일 그래프 — 가로 위치에서 가장 가까운 날짜에 세로선을 붙이고 값을 보여 준다.
   값은 textContent 로만 넣는다. 키보드: 그래프에 초점을 두고 ←/→. */
(function () {
  document.querySelectorAll('.cx-chart').forEach(function (el) {
    var pts = JSON.parse(el.dataset.pts), days = JSON.parse(el.dataset.days);
    var pl = +el.dataset.pl, pr = +el.dataset.pr, pt = +el.dataset.pt, pb = +el.dataset.pb;
    var hi = +el.dataset.hi, lo = +el.dataset.lo, span = (hi - lo) || 1;
    var svg = el.querySelector('svg'), cross = el.querySelector('.cx-cross');
    var dot = el.querySelector('.cx-hover-dot'), tip = el.querySelector('.cx-tip');
    var vw = svg.viewBox.baseVal.width, vh = svg.viewBox.baseVal.height;
    var cur = pts.length - 1;
    function fmt(v) { return '$' + v.toLocaleString('en-US', {maximumFractionDigits: v >= 1000 ? 0 : 2}); }
    function show(i) {
      cur = Math.max(0, Math.min(pts.length - 1, i));
      var x = pl + cur * (vw - pl - pr) / (pts.length - 1);
      var y = pt + (hi - pts[cur]) / span * (vh - pt - pb);
      cross.setAttribute('x1', x); cross.setAttribute('x2', x);
      el.classList.add('on');
      var left = x / vw * 100;
      dot.style.left = left + '%'; dot.style.top = y + 'px';
      tip.textContent = '';
      var b = document.createElement('b'); b.textContent = fmt(pts[cur]);
      var s = document.createElement('span');
      s.textContent = ' ' + (days[cur] === '지금' ? '지금' : days[cur] + ' 오전 9시');
      tip.appendChild(b); tip.appendChild(s);
      tip.style.left = left + '%';
      tip.classList.toggle('r', left > 65); tip.classList.toggle('l', left < 35);
    }
    function hide() { el.classList.remove('on'); }
    function fromEvent(e) {
      var r = svg.getBoundingClientRect();
      var x = (e.clientX - r.left) / r.width * vw;
      show(Math.round((x - pl) / ((vw - pl - pr) / (pts.length - 1))));
    }
    el.addEventListener('pointermove', fromEvent);
    el.addEventListener('pointerdown', fromEvent);
    el.addEventListener('pointerleave', hide);
    el.addEventListener('focus', function () { show(cur); });
    el.addEventListener('blur', hide);
    el.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowLeft') { show(cur - 1); e.preventDefault(); }
      if (e.key === 'ArrowRight') { show(cur + 1); e.preventDefault(); }
    });
  });
})();
</script>
{% endif %}
