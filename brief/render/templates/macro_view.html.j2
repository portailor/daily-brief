{# 핵심 거시 이슈 · 과거 데이터로 본 참고 — brief/interpret/macro_view.py
   원인을 단정하지 않고(일반적 관계만), 행동을 권하지 않는다(과거 통계만). #}
{% if macro_view %}
<section>
  <h2>오늘의 경제 신호 · 과거엔 어땠나</h2>
  <p class="hint-plain">오늘 평소보다 크게 움직였거나 1년 최고·최저 근처에 닿은 지표 · 시사점은 일반적인 관계이고 오늘 움직인 원인이라고 확인된 것은 아닙니다</p>
  <div class="card">
    {% for m in macro_view %}
    <div class="mv-item">
      <div class="mv-title">{{ m.title }}</div>
      <div class="mv-fact">{{ m.fact }}</div>
      {% if m.relation %}<div class="mv-rel">시사점 · {{ m.relation }}</div>{% endif %}
      <div class="mv-ref">
        <b>과거 데이터로 본 참고</b> · {{ m.cond }}{% if m.episodes %}은 {{ m.since }}년 이후 {{ m.episodes }}번{% endif %}
        {% if m.stats %}
          {% for s in m.stats %}
          <div class="mv-bar">
            <span class="lbl">{{ s.target }}</span>
            <span class="track" title="20거래일 뒤 오른 비율 {{ s.up }}% · 평소 {{ s.base.up if s.base else '—' }}%">
              <span class="fill" style="width:{{ s.up }}%;display:block"></span>
              {% if s.base %}<span class="base" style="left:{{ s.base.up }}%"></span>{% endif %}
            </span>
            <span class="v">오른 비율 {{ s.up }}% · 중앙값 {{ '%+.1f'|format(s.median) }}% ({{ s.n }}번)</span>
          </div>
          {% endfor %}
          <div class="re-src" style="margin-top:4px">20거래일(약 한 달) 뒤 기준 · 막대 속 세로선 = 평소(모든 날) 오른 비율
            {%- for s in m.stats %}{% if s.base %} · {{ s.target }} 평소 {{ s.base.up }}%{% endif %}{% endfor %}
            · 조건이 며칠 이어져도 처음 날 한 번만 셉니다 · 괄호 안은 한 달 뒤까지 확인된 횟수</div>
        {% else %}
          <div class="re-src" style="margin-top:4px">과거 사례가 적어({{ m.episodes }}번) 통계를 내지 않았습니다.</div>
        {% endif %}
      </div>
      {% if m.news %}
      <div class="mv-news">같은 주제의 오늘 기사 ·
        {% for n in m.news %}<a href="{{ n.url }}" target="_blank" rel="noopener">{{ n.title }}</a><span class="nw-meta-inline">{{ n.source }}</span>{% endfor %}
      </div>
      {% endif %}
    </div>
    {% endfor %}
    <div class="re-src" style="margin-top:8px">과거에 그랬다는 통계일 뿐 앞으로도 그렇다는 보장이 아니며, 투자 권유가 아닙니다.</div>
  </div>
</section>
{% endif %}

{% set tn = theme_news or {} %}
{% if tn.themes %}
<section>
  <h2>주제별 뉴스 · 오늘 하루</h2>
  <p class="hint-plain">최근 24시간 기사 중 제목에 주제어가 들어간 것 · 제목과 원문 링크만 모았습니다(요약 없음) · 연합뉴스·네이버 뉴스 검색 · {{ tn.asof }} 기준</p>
  <div class="card">
    {% for t in tn.themes if t.news %}
    <div class="re-item">
      <div class="re-sub" style="margin-bottom:2px">{{ t.name }}</div>
      <ul class="nw-list">
        {% for n in t.news %}
        <li><a href="{{ n.url }}" target="_blank" rel="noopener">{{ n.title }}</a>
          <span class="nw-meta">{{ n.source }} · {{ n.when }}</span></li>
        {% endfor %}
      </ul>
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}
