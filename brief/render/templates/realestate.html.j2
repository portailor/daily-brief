{# 부동산 탭. 주간·월간 통계라 매일 바뀌지 않는다 — 모든 값에 기준 시점을 붙인다. #}
{% set re = realestate or {} %}
{% set kw = re.kr_weekly or {} %}
{% set sale = kw.sale %}
{% set jeonse = kw.jeonse %}

<section>
  <h2>한국 아파트값 · 한 주 사이</h2>
  {% if sale %}
  <p class="hint-plain">{{ re_terms.weekly|safe }} · <b>{{ sale.date[5:7]|int }}/{{ sale.date[8:10]|int }} 기준</b>
    · 매주 목요일 공표. 전주 대비 변동률입니다.</p>
  {% set groups = [('main', '권역', '전국 · 수도권 · 서울 · 지방'),
                   ('metro', '광역시', '인천 · 부산 · 대구 · 광주 · 대전 · 울산 · 세종')] %}
  {% for grp, title, sub in groups %}
  {% set rows = sale.regions | selectattr('group', 'equalto', grp) | list %}
  {% if rows %}
  <div class="card re-group g-{{ grp }}">
    <div class="re-group-h"><span class="re-tag t-{{ grp }}">{{ title }}</span><span class="re-group-sub">{{ sub }}</span></div>
    <div class="re-row re-head">
      <span>지역</span><span>매매</span>{% if jeonse %}<span>{{ re_terms.jeonse|safe if loop.first else '전세' }}</span>{% endif %}
    </div>
    {% for r in rows %}
    {% set j = (jeonse.regions | selectattr('name', 'equalto', r.name) | first) if jeonse else none %}
    <div class="re-row">
      <span class="re-name">{{ r.name }}</span>
      <span class="num {{ 'up' if r.chg > 0 else 'down' if r.chg < 0 else '' }}">
        {{ ('%+.2f'|format(r.chg) ~ '%') if r.chg else '보합' }}{% if r.streak >= 2 %}<span class="re-streak">{{ r.streak }}주{{ ' 이상' if r.streak_capped else '째' }} {{ '상승' if r.chg > 0 else '하락' }}</span>{% endif %}
      </span>
      {% if jeonse %}
      <span class="num {{ 'up' if j and j.chg > 0 else 'down' if j and j.chg < 0 else '' }}">
        {{ (('%+.2f'|format(j.chg) ~ '%') if j.chg else '보합') if j else '—' }}
      </span>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}
  {% endfor %}

  {% if sale.gu_top and sale.gu_bottom %}
  <h3 class="re-h3">서울 구별 <span class="re-group-sub">한 주 사이 많이 오른 곳 · 덜 오르거나 내린 곳</span></h3>
  <div class="re-two">
    <div class="card">
      <div class="re-sub">서울에서 많이 오른 구</div>
      {% for r in sale.gu_top %}<div class="re-pair"><span>{{ r.name }}{% if r.streak >= 2 %}<span class="re-streak">{{ r.streak }}주{{ ' 이상' if r.streak_capped else '째' }} {{ '상승' if r.chg > 0 else '하락' }}</span>{% endif %}</span><span class="num {{ 'up' if r.chg > 0 else 'down' if r.chg < 0 else '' }}">{{ '%+.2f'|format(r.chg) }}%</span></div>{% endfor %}
    </div>
    <div class="card">
      <div class="re-sub">서울에서 덜 오르거나 내린 구</div>
      {% for r in sale.gu_bottom %}<div class="re-pair"><span>{{ r.name }}{% if r.streak >= 2 %}<span class="re-streak">{{ r.streak }}주{{ ' 이상' if r.streak_capped else '째' }} {{ '상승' if r.chg > 0 else '하락' }}</span>{% endif %}</span><span class="num {{ 'up' if r.chg > 0 else 'down' if r.chg < 0 else '' }}">{{ '%+.2f'|format(r.chg) }}%</span></div>{% endfor %}
    </div>
  </div>
  {% endif %}

  {% if kw.sale_sd %}
  <h3 class="re-h3">{{ re_terms.sd|safe }} <span class="re-group-sub">100보다 크면 사려는 사람이 더 많음</span></h3>
  {% for grp, title, sub in groups %}
  {% set rows = kw.sale_sd | selectattr('group', 'equalto', grp) | list %}
  {% if rows %}
  <div class="card re-group g-{{ grp }}">
    <div class="re-group-h"><span class="re-tag t-{{ grp }}">{{ title }}</span></div>
    <div class="re-row re-head"><span>지역</span><span>매매</span>{% if kw.jeonse_sd %}<span>전세</span>{% endif %}</div>
    {% for r in rows %}
    {% set j = (kw.jeonse_sd | selectattr('name', 'equalto', r.name) | first) if kw.jeonse_sd else none %}
    <div class="re-row">
      <span class="re-name">{{ r.name }}</span>
      <span class="num {{ 'up' if r.value > 100 else 'down' if r.value < 100 else '' }}">{{ '%.1f'|format(r.value) }}
        <span class="re-streak">지난주 {{ '%+.1f'|format(r.chg) if r.chg else '같음' }}</span></span>
      {% if kw.jeonse_sd %}
      <span class="num {{ 'up' if j and j.value > 100 else 'down' if j and j.value < 100 else '' }}">{{ ('%.1f'|format(j.value)) if j else '—' }}
        {% if j %}<span class="re-streak">지난주 {{ '%+.1f'|format(j.chg) if j.chg else '같음' }}</span>{% endif %}</span>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}
  {% endfor %}
  <div class="re-src" style="margin-top:6px">한국부동산원 · 0~200, 100 = 사려는 사람과 팔려는 사람이 비슷</div>
  {% endif %}
  {% else %}
  <div class="card"><div class="pocket nodata">
    한국부동산원 주간 아파트 가격은 인증키를 연결하면 표시됩니다.
  </div></div>
  {% endif %}
</section>

{% macro md(d) %}{{ d[5:7]|int }}/{{ d[8:10]|int }}{% endmacro %}
{% set hs = housing or {} %}
{% if hs.upcoming or hs.results %}
{# 지역별로 묶는다 — 접수일 순으로만 늘어놓으면 충남·울산·충남처럼 섞였다(9/23).
   순서는 수도권 → 광역시 → 도. 목록에 없는 이름은 뒤에 붙인다. #}
{% set REG_ORDER = ['서울','인천','경기','부산','대구','광주','대전','울산','세종',
                    '강원','충북','충남','전북','전남','경북','경남','제주'] %}
{% macro regions(items) %}{{ (REG_ORDER + (items | map(attribute='area') | reject('in', REG_ORDER) | unique | list)) | join('|') }}{% endmacro %}
<section>
  <h2>청약 · 이번 주</h2>
  {% if hs.upcoming %}
  <div class="card">
    <div class="re-sub">앞으로 7일 안에 청약 접수를 시작하는 단지</div>
    {% for reg in regions(hs.upcoming).split('|') %}
    {% set items = hs.upcoming | selectattr('area', 'equalto', reg) | list %}
    {% if items %}
    <div class="re-reg">{{ reg or '지역 미상' }}<span class="re-reg-n">{{ items|length }}곳</span></div>
    {% for u in items %}
    <div class="re-item">
      <div class="re-name">{% if u.url %}<a href="{{ u.url }}" target="_blank" rel="noopener" style="color:inherit">{{ u.name }}</a>{% else %}{{ u.name }}{% endif %}</div>
      <div class="re-note">접수 {{ md(u.start) }}{% if u.end and u.end != u.start %}~{{ md(u.end) }}{% endif %}{% if u.announce %} · 발표 {{ md(u.announce) }}{% endif %} · {{ '{:,}'.format(u.units) if u.units else '—' }}세대{% if u.kind and u.kind != 'APT' %} · {{ u.kind }}{% endif %}</div>
    </div>
    {% endfor %}
    {% endif %}
    {% endfor %}
  </div>
  {% endif %}
  {% if hs.results %}
  <div class="card" style="margin-top:8px">
    <div class="re-sub">최근 7일 안에 접수가 끝난 단지 · 평균 경쟁률</div>
    {% for reg in regions(hs.results).split('|') %}
    {% set items = hs.results | selectattr('area', 'equalto', reg) | list %}
    {% if items %}
    <div class="re-reg">{{ reg or '지역 미상' }}<span class="re-reg-n">{{ items|length }}곳</span></div>
    {% for r in items %}
    <div class="re-item">
      <div class="re-name">{{ r.name }}</div>
      <div class="re-item-val">
        {% if r.req %}
        <span class="num re-big {{ 'up' if r.avg >= 1 else 'down' }}">{{ '%.2f'|format(r.avg) }} : 1</span>
        {% else %}
        <span class="num re-big down">접수 없음</span>
        {% endif %}
        <span class="re-note">{{ '{:,}'.format(r.req) }}건 ÷ {{ '{:,}'.format(r.supply) }}세대{% if r.short_types %} · {{ r.types }}개 주택형 중 {{ r.short_types }}개 미달{% endif %}</span>
      </div>
      {% if r.best %}<div class="re-src">1순위 해당지역 최고: {{ r.best_type }} {{ '%.2f'|format(r.best) }} : 1</div>{% endif %}
    </div>
    {% endfor %}
    {% endif %}
    {% endfor %}
    <div class="re-src" style="margin-top:6px">한국부동산원 청약홈 · 평균 경쟁률 = 1·2순위 전체 접수 ÷ 일반공급 세대</div>
  </div>
  {% endif %}
</section>
{% endif %}

{% if hs.seoul %}
{% set s = hs.seoul %}
<section>
  <h2>서울 아파트 실거래</h2>
  <div class="card">
    <div class="re-item">
      <div class="re-item-top"><span class="re-name">거래량 · {{ s.month }}</span><span class="asof">신고 기한 지난 달</span></div>
      <div class="re-item-val">
        <span class="num re-big">{{ '{:,}'.format(s.count) }}건</span>
        <span class="re-note">{{ s.prev_month }} {{ '{:,}'.format(s.prev) }}건 · {{ s.year_ago_month }} {{ '{:,}'.format(s.year_ago) }}건</span>
      </div>
    </div>
    {% if s.recent_top %}
    <div class="re-sub" style="margin-top:10px">최근 7일 계약된 거래 중 금액 상위 (중개거래, {{ s.recent_n }}건 중)</div>
    {% for r in s.recent_top %}
    <div class="re-pair">
      <span>{{ r.apt }} <span class="tk">{{ r.gu }} · {{ '%.0f'|format(r.area) }}㎡ · {{ r.floor }}층 · {{ md(r.date) }}</span></span>
      <span class="num">{{ '%.2f'|format(r.man / 10000) }}억</span>
    </div>
    {% endfor %}
    {% endif %}
    {% if s.highs_from %}
    <div class="re-sub" style="margin-top:12px">신고가 · 최근 7일 계약 {{ s.highs_n }}건{% if s.highs_n > s.highs|length %} · 거래가 큰 {{ s.highs|length }}건{% endif %}</div>
    {% for r in s.highs %}
    <div class="re-item">
      <div class="re-item-top">
        <span class="re-name">{{ r.apt }}</span>
        <span class="num up">{{ '%.2f'|format(r.man / 10000) }}억</span>
      </div>
      <div class="re-note">{{ r.gu }} {{ r.dong }} · {{ '%.0f'|format(r.area) }}㎡ · {{ r.floor }}층 · {{ md(r.date) }}
        · 직전 최고 {{ '%.2f'|format(r.prev_man / 10000) }}억{% if r.prev_date %}({{ r.prev_date[:7].replace('-', '.') }}){% endif %}
        보다 {{ '%+.1f'|format((r.man - r.prev_man) / r.prev_man * 100) }}%</div>
    </div>
    {% else %}
    <div class="re-note">최근 7일 계약된 거래 중 신고가는 없습니다.</div>
    {% endfor %}
    <div class="re-src">{{ s.highs_from }} 이후 같은 단지·같은 평형(전용면적 ±1㎡)의 최고가를 넘은 거래 · 직거래·해제 제외(2021년 11월 전 거래는 거래 방식 표시가 없어 모두 포함)</div>
    {% endif %}
    <div class="re-src" style="margin-top:6px">국토교통부 실거래 신고 기준 · 해제된 거래 제외.
      서울시·부동산원 공표 통계와 수십 건 차이가 날 수 있습니다 (예: 2026년 7월 신고 기준 5,850건, 공표 5,838건).</div>
  </div>
</section>
{% endif %}

{% if re.kr_monthly %}
<section>
  <h2>대출 금리 · 미분양 · 실거래 (월간)</h2>
  <p class="hint-plain">달마다 나오는 통계라 기준 달이 항목마다 다릅니다.</p>
  <div class="card">
    {% for i in re.kr_monthly %}
    <div class="re-item">
      <div class="re-item-top">
        <span class="re-name">{{ i.name_html|safe }}</span>
        <span class="asof">{{ i.asof }}</span>
      </div>
      <div class="re-item-val">
        <span class="num re-big">{{ i.value }}</span>
        <span class="num {{ i.dir }}">{{ i.change }}</span>
        <span class="re-note">전월 대비{% if i.note and '전월 대비' not in i.note %} · {{ i.note }}{% endif %}</span>
      </div>
      <div class="re-src">{{ i.source }}</div>
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}

{% if re.us %}
<section>
  <h2>미국 주택시장</h2>
  <div class="card">
    {% for i in re.us %}
    <div class="re-item">
      <div class="re-item-top">
        <span class="re-name">{{ i.name_html|safe }}</span>
        <span class="asof">{{ i.asof }}</span>
      </div>
      <div class="re-item-val">
        <span class="num re-big">{{ i.value }}</span>
        <span class="num {{ i.dir }}">{{ i.change }}</span>
        <span class="re-note">{{ i.note or ('전주 대비' if 'MORTGAGE' in i.id else '') }}</span>
      </div>
      <div class="re-src">{{ i.source }}</div>
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}

{% if re.missing %}
<div class="pocket nodata" style="margin-top:14px">가져오지 못한 항목: {{ re.missing|join(', ') }}</div>
{% endif %}

<section>
  <details>
    <summary>숫자를 읽는 법</summary>
    <div class="deep">
      모든 값은 공공기관·공식 집계 기관이 발표한 숫자를 그대로 옮기거나, 발표된 지수로
      변동률만 계산한 것입니다. 오를지 내릴지에 대한 전망은 넣지 않았습니다.<br><br>
      <b>주간 아파트값</b>은 한국부동산원이 표본 아파트를 매주 조사한 지수에서 전주 대비
      변동률을 계산한 것입니다. 기사에서 보는 "서울 아파트값 0.○○% 상승"과 같은 통계입니다.<br><br>
      <b>기사마다 숫자가 다른 이유</b> — 주간 아파트값은 한국부동산원 말고도 KB부동산,
      부동산114 등이 따로 조사합니다. 표본과 조사 방식이 달라 같은 주에도 수치가 다릅니다
      (예: 9/14 주 서울을 한국부동산원은 +0.16%, 부동산114는 +0.03%로 발표).
      이 탭은 정부 승인 통계인 한국부동산원 수치만 씁니다.<br><br>
      <b>월간 통계</b>는 발표까지 시간이 걸립니다. 특히 실거래가격지수는 거래 신고를 모아
      계산해 두세 달 늦게 나옵니다. 그래서 항목마다 기준 달을 따로 적었습니다.
    </div>
  </details>
</section>
